# Copia este archivo como .env. Nunca publiques .env.
APP_ADDR=127.0.0.1:8095
DATABASE_URL=postgres://ytdlbot:CAMBIAR@127.0.0.1:55435/ytdlbot?sslmode=disable
POSTGRES_PASSWORD=CAMBIAR
BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=
# Cerrado por defecto: solo administradores y estos IDs pueden usar el bot.
ALLOWED_USER_IDS=
PUBLIC_ACCESS=false
PUBLIC_URL=
TELEGRAM_API_URL=http://127.0.0.1:8081
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
DATA_DIR=./data
YTDLP_PATH=yt-dlp
GALLERYDL_PATH=gallery-dl
FFMPEG_PATH=ffmpeg
WORKERS=1
# Tareas activas por usuario. 2 permite dos descargas propias en paralelo;
# con muchos usuarios usa 1 para repartir mejor los workers.
MAX_ACTIVE_PER_USER=2
# Capacidad total de la cola y conexiones de PostgreSQL.
MAX_QUEUE=1000
DB_MAX_CONNS=16
# Subidas simultáneas a Telegram; no cambia la concurrencia de descargas.
MAX_CONCURRENT_UPLOADS=2
MAX_FILE_MB=1900
MAX_PENDING_PER_USER=5
DAILY_LIMIT=50
MAX_PLAYLIST_ITEMS=20
JOB_TIMEOUT_MINUTES=90
RETENTION_HOURS=24
RAM_PART_MB=512
FFMPEG_THREADS=2
FFMPEG_ENCODER=auto
MIN_FREE_DISK_MB=4096
# Activar después de configurar bot, dominio y contacto de soporte.
ENABLE_PAYMENTS=false
PREMIUM_STARS=50
SUPPORT_URL=
# Panel local fuera de Telegram: clave independiente, mínimo 32 caracteres.
LOCAL_ADMIN_KEY=
# Cookies del propietario: solamente los administradores pueden usarlas.
COOKIES_FILE=
ENABLE_GALLERY=true
# Proxy de salida controlado por el administrador. Los usuarios no pueden elegirlo.
DOWNLOAD_PROXY=
# Opcional: sesión del propietario para canales autorizados y Mensajes guardados.
# Activar después de compilar y ejecutar bin/mtproto.exe -login localmente.
MTPROTO_PATH=

# Archivos unidos de hasta 4 GiB, solo para el propietario Premium en Mensajes guardados.
MTPROTO_SAVED_UPLOADS=false
# Solicitudes de carga concurrentes, de 1 a 8; memoria acotada.
MTPROTO_UPLOAD_THREADS=4
# Bloques concurrentes al descargar un mensaje de Telegram, de 1 a 8.
MTPROTO_DOWNLOAD_THREADS=2
